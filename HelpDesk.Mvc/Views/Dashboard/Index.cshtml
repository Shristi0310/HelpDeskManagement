@model HelpDesk.Mvc.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-md-12">
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Help Desk Dashboard</h2>
        <p class="text-secondary">Overview of all support tickets and metrics</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Total Tickets -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-primary text-white h-100">
            <div class="card-body p-4 text-center">
                <i class="bi bi-ticket-perforated display-4 mb-2"></i>
                <h5 class="card-title text-uppercase fs-6 text-white-50">Total Tickets</h5>
                <h1 class="display-3 fw-bold my-2">@Model.TotalTickets</h1>
                <a asp-controller="Tickets" asp-action="Index" class="btn btn-light text-primary btn-sm rounded-pill fw-bold">View All Tickets</a>
            </div>
        </div>
    </div>

    <!-- Open Tickets -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-warning text-dark h-100">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-circle display-4 mb-2"></i>
                <h5 class="card-title text-uppercase fs-6 text-dark-50 fw-bold">Open Tickets</h5>
                <h1 class="display-3 fw-bold my-2">@Model.OpenTickets</h1>
                <a asp-controller="Tickets" asp-action="Filter" asp-route-status="Open" class="btn btn-dark text-white btn-sm rounded-pill fw-bold">Filter Open Tickets</a>
            </div>
        </div>
    </div>

    <!-- Closed Tickets -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-success text-white h-100">
            <div class="card-body p-4 text-center">
                <i class="bi bi-check-circle display-4 mb-2"></i>
                <h5 class="card-title text-uppercase fs-6 text-white-50">Closed Tickets</h5>
                <h1 class="display-3 fw-bold my-2">@Model.ClosedTickets</h1>
                <a asp-controller="Tickets" asp-action="Filter" asp-route-status="Closed" class="btn btn-light text-success btn-sm rounded-pill fw-bold">Filter Closed Tickets</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1">Quick Action</h5>
                    <p class="text-muted mb-0">Need to report a new software, hardware or network issue?</p>
                </div>
                <a asp-controller="Tickets" asp-action="Create" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i>Raise New Ticket
                </a>
            </div>
        </div>
    </div>
</div>
