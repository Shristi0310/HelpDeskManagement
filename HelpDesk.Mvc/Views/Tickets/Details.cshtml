@model HelpDesk.Mvc.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
    <h2 class="fw-bold text-dark"><i class="bi bi-ticket-detailed text-info me-2"></i>Ticket Details #@Model.Id</h2>
</div>

<div class="card border-0 shadow-sm col-md-8 mx-auto">
    <div class="card-header bg-light py-3 border-0">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-primary">@Model.Title</h5>
            <div>
                <span class="badge bg-secondary me-1">Priority: @Model.Priority</span>
                <span class="badge bg-primary">Status: @Model.Status</span>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Ticket ID</dt>
            <dd class="col-sm-9 fw-bold">#@Model.Id</dd>

            <dt class="col-sm-3 text-muted">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3 text-muted">Description</dt>
            <dd class="col-sm-9 bg-light p-3 rounded">@Model.Description</dd>

            <dt class="col-sm-3 text-muted mt-3">Raised By</dt>
            <dd class="col-sm-9 mt-3">@Model.RaisedBy</dd>

            <dt class="col-sm-3 text-muted">Created Date</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToString("F")</dd>

            <dt class="col-sm-3 text-muted">Priority</dt>
            <dd class="col-sm-9">
                @if (Model.Priority == "High")
                {
                    <span class="badge bg-danger">High</span>
                }
                else if (Model.Priority == "Medium")
                {
                    <span class="badge bg-warning text-dark">Medium</span>
                }
                else
                {
                    <span class="badge bg-secondary">Low</span>
                }
            </dd>

            <dt class="col-sm-3 text-muted">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Status == "Open")
                {
                    <span class="badge bg-info text-dark">Open</span>
                }
                else if (Model.Status == "In Progress")
                {
                    <span class="badge bg-primary">In Progress</span>
                }
                else
                {
                    <span class="badge bg-success">Closed</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-light border-0 text-end py-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill me-2 fw-bold">
            <i class="bi bi-pencil me-1"></i>Edit Ticket
        </a>
        <a asp-action="Index" class="btn btn-secondary rounded-pill fw-bold">Back to List</a>
    </div>
</div>
