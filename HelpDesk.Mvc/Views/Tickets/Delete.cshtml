@model HelpDesk.Mvc.Models.Ticket

@{
    ViewData["Title"] = "Delete Ticket";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
    <h2 class="fw-bold text-danger"><i class="bi bi-trash text-danger me-2"></i>Delete Ticket #@Model.Id</h2>
    <p class="text-secondary">Are you sure you want to permanently delete this ticket?</p>
</div>

<div class="card border-danger shadow-sm col-md-8 mx-auto">
    <div class="card-header bg-danger text-white py-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Confirmation Required</h5>
    </div>
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Title</dt>
            <dd class="col-sm-9 fw-bold">@Model.Title</dd>

            <dt class="col-sm-3 text-muted">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3 text-muted">Raised By</dt>
            <dd class="col-sm-9">@Model.RaisedBy</dd>

            <dt class="col-sm-3 text-muted">Priority</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Priority</span></dd>

            <dt class="col-sm-3 text-muted">Status</dt>
            <dd class="col-sm-9"><span class="badge bg-primary">@Model.Status</span></dd>

            <dt class="col-sm-3 text-muted">Created Date</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToString("F")</dd>
        </dl>
    </div>
    <div class="card-footer bg-light border-0 d-flex justify-content-between py-3">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                <i class="bi bi-trash me-1"></i>Delete Ticket
            </button>
        </form>
    </div>
</div>
