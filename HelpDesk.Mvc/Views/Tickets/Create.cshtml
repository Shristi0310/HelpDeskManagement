@model HelpDesk.Mvc.Models.Ticket

@{
    ViewData["Title"] = "Raise New Ticket";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
    <h2 class="fw-bold text-dark"><i class="bi bi-plus-circle text-primary me-2"></i>Raise New Ticket</h2>
    <p class="text-secondary">Submit a new support ticket to the help desk</p>
</div>

<div class="card border-0 shadow-sm col-md-8 mx-auto">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold"></label>
                <input asp-for="Title" class="form-control" placeholder="Brief summary of the issue" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed explanation of the support request"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RaisedBy" class="form-label fw-semibold"></label>
                <input asp-for="RaisedBy" class="form-control" placeholder="Your Name / Employee Name" />
                <span asp-validation-for="RaisedBy" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Priority" class="form-label fw-semibold"></label>
                <select asp-for="Priority" asp-items="ViewBag.Priorities" class="form-select">
                    <option value="">-- Select Priority --</option>
                </select>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>

            <!-- Status is hardcoded to 'Open' as per assignment requirement -->
            <input type="hidden" asp-for="Status" value="Open" />
            <div class="mb-4">
                <label class="form-label fw-semibold text-muted">Status</label>
                <input type="text" class="form-control bg-light" value="Open (Hardcoded)" readonly />
                <small class="text-muted">New tickets are automatically assigned status 'Open'.</small>
            </div>

            <div class="d-flex justify-content-between pt-3">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                    <i class="bi bi-check-lg me-1"></i>Submit Ticket
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
